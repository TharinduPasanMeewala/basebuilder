{
  "name": "Blueprint",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "version_id": {
      "type": "string",
      "title": "Version ID"
    },
    "title": {
      "type": "string",
      "title": "Blueprint Title"
    },
    "executive_summary": {
      "type": "string",
      "title": "Executive Summary"
    },
    "package": {
      "type": "object",
      "title": "Full Blueprint Package (JSON)"
    },
    "completeness_score": {
      "type": "number",
      "title": "Completeness Score"
    },
    "sections_included": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Sections Included"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "final",
        "exported"
      ],
      "default": "draft",
      "title": "Status"
    },
    "generated_by": {
      "type": "string",
      "title": "Generated By"
    }
  },
  "required": [
    "project_id",
    "title"
  ]
}