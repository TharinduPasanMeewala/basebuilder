{
  "name": "AIConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "gemini",
        "compatible"
      ]
    },
    "base_url": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "api_key": {
      "type": "string",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "json_mode": {
      "type": "boolean",
      "default": false
    },
    "supports_images": {
      "type": "boolean",
      "default": false
    },
    "max_tokens": {
      "type": "integer",
      "default": 8192
    },
    "last_tested_at": {
      "type": "string"
    },
    "last_test_ok": {
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "name",
    "provider",
    "model"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}