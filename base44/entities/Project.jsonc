{
  "name": "Project",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "name": {
      "type": "string",
      "title": "Project Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft",
      "title": "Status"
    },
    "app_type": {
      "type": "string",
      "title": "App Type"
    },
    "theme": {
      "type": "object",
      "title": "Theme"
    },
    "local_ai_mode": {
      "type": "string",
      "enum": [
        "base44",
        "hybrid",
        "local_first"
      ],
      "default": "hybrid",
      "title": "AI Mode"
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    }
  },
  "required": [
    "workspace_id",
    "name"
  ]
}