{
  "name": "ProjectDesign",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "primary_color": {
      "type": "string",
      "default": "#6366f1",
      "title": "Primary Color"
    },
    "accent_color": {
      "type": "string",
      "default": "#10b981",
      "title": "Accent Color"
    },
    "background_color": {
      "type": "string",
      "default": "#f8fafc",
      "title": "Background Color"
    },
    "surface_color": {
      "type": "string",
      "default": "#ffffff",
      "title": "Surface Color"
    },
    "text_color": {
      "type": "string",
      "default": "#0f172a",
      "title": "Text Color"
    },
    "font_family": {
      "type": "string",
      "default": "Inter",
      "title": "Font Family"
    },
    "radius": {
      "type": "number",
      "default": 16,
      "title": "Corner Radius"
    },
    "density": {
      "type": "string",
      "enum": [
        "comfortable",
        "compact",
        "spacious"
      ],
      "default": "comfortable",
      "title": "Density"
    },
    "muted_color": {
      "type": "string"
    },
    "border_color": {
      "type": "string"
    },
    "sidebar_color": {
      "type": "string"
    },
    "sidebar_text": {
      "type": "string"
    },
    "heading_font": {
      "type": "string"
    },
    "hero_title": {
      "type": "string"
    },
    "hero_description": {
      "type": "string"
    },
    "hero_eyebrow": {
      "type": "string"
    },
    "hero_cta": {
      "type": "string"
    },
    "reference_summary": {
      "type": "string"
    },
    "design_notes": {
      "type": "string"
    },
    "app_name": {
      "type": "string"
    },
    "visual_preset": {
      "type": "string",
      "enum": [
        "orbit",
        "grove",
        "noir",
        "atelier",
        "mono",
        "coral"
      ]
    },
    "layout": {
      "type": "string",
      "enum": [
        "sidebar",
        "topbar"
      ]
    },
    "dashboard_layout": {
      "type": "string",
      "enum": [
        "analytics",
        "workspace",
        "editorial"
      ]
    },
    "nav_width": {
      "type": "number"
    },
    "content_width": {
      "type": "number"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_uri": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "project_id"
  ]
}